{
  "name": "@crapplet/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test --test-concurrency=1 test/e2e.test.ts test/whmcs-import.test.ts test/sqldump.test.ts test/automation.test.ts test/whatsapp.test.ts test/currency.test.ts test/virtualizor-os.test.ts test/placement.test.ts test/email.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.34.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "nodemailer": "6.9.16",
    "otplib": "12.0.1",
    "pdfkit": "0.15.2",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "undici": "6.21.0",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.8",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.5.12",
    "prisma": "7.10.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
