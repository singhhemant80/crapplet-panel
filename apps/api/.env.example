NODE_ENV=production
API_PORT=4000
APP_URL=https://crapplet.co.in
DATABASE_URL=postgresql://crapplet:CHANGE_ME@127.0.0.1:5432/crapplet
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=generate-with-openssl-rand-hex-48
APP_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
COOKIE_SECURE=auto
UPLOAD_DIR=/var/lib/crapplet/uploads
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=billing@crapplet.co.in
SMTP_PASS=
SMTP_FROM="Crapplet Cloud <billing@crapplet.co.in>"
INBOUND_EMAIL_SECRET=
IP_RESERVATION_MINUTES=15
# true = simulate hypervisor calls (staging/demo only)
PROVISION_DRY_RUN=false
